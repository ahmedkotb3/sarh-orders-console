# Copy to .env and change the secrets before using outside local development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sarh_orders?schema=public"
JWT_SECRET="replace-with-at-least-32-random-bytes"
JWT_ISSUER="sarh-orders-console"
JWT_AUDIENCE="sarh-orders-client"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
